{
  "name": "fixit",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:migrate": "pnpm --filter @fixit/db migrate",
    "db:push": "pnpm --filter @fixit/db prisma db push",
    "db:seed": "pnpm --filter @fixit/db db:seed"
  },
  "devDependencies": {
    "prettier": "^3.0.0",
    "prisma": "^5.7.0",
    "turbo": "^2.0.0"
  },
  "dependencies": {
    "@prisma/client": "^5.7.0"
  }
}
