{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "outputs": ["dist/", ".next/"],
      "dependsOn": ["^build"]
    },
    "test": {
      "outputs": ["coverage/"],
      "dependsOn": ["^build"]
    },
    "type-check": {
      "outputs": []
    },
    "lint": {
      "outputs": []
    }
  }
}
